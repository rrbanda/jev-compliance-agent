# ── LLM (System 2 — Gemini via Google AI API) ──────────────────────
# Get your key at https://aistudio.google.com/apikey
# NEVER commit the actual key — only this placeholder file is tracked.
GOOGLE_API_KEY=your-gemini-api-key-here
MODEL_NAME=gemini-2.5-flash

# ── Laya (System 1a — Fast, CPU, ~145ms) ───────────────────────────
# Laya decision engine on RHOAI. Speaks Jev /v1/systemone.
LAYA_API_URL=https://laya-api-gpu-laya-demo.apps.ocp.qn6c5.sandbox1388.opentlc.com

# ── DiffusionGemma (System 1b — Deep, H200 MIG, ~10-26s) ──────────
# DiffusionGemma 26B-A4B on H200 MIG 3g.71gb. Speaks Jev /v1/systemone.
DIFFUSIONGEMMA_API_URL=https://dgemma-jev-user-rbanda.apps.ocp.cloud.rhai-tmm.dev

# ── System 1 routing ───────────────────────────────────────────────
# "fast" = Laya only, "deep" = DiffusionGemma only, "auto" = Laya
# first, escalate to DiffusionGemma if confidence < threshold.
SYSTEM1_MODE=auto
SYSTEM1_CONFIDENCE_THRESHOLD=0.80

# ── MLflow Tracing (optional — set URI to enable) ──────────────────
# MLFLOW_TRACKING_URI=https://mlflow-laya-demo.apps.ocp.qn6c5.sandbox1388.opentlc.com
# MLFLOW_TRACKING_INSECURE_TLS=true
# MLFLOW_EXPERIMENT_NAME=cross-border-data-router
# MLFLOW_HEALTH_CHECK_TIMEOUT=5

# ── Optional ────────────────────────────────────────────────────────
# ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
